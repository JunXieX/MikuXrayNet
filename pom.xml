<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.mikumc</groupId>
    <artifactId>mikuxraynet</artifactId>
    <version>1.1.10</version>
    <packaging>jar</packaging>

    <name>MikuXrayNet</name>
    <description>MikuMC 服务器原创插件</description>

    <developers>
        <developer>
            <name>JunXieX</name>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Paper 26.x 稳定通道最新版（26.3 目前仅有 -alpha，不作为编译目标） -->
        <paper.version>26.2.build.129-stable</paper.version>

        <!--
          PacketEvents 仅作为「库」使用：启动期读取方块状态映射，运行期不进热路径。
          它是服务端已安装的前置插件，故 scope=provided（编译可见、不打包）。
          该制品只发布在 CodeMC 仓库，未上 Maven Central。
        -->
        <packetevents.version>2.13.0</packetevents.version>

        <!--
          ProtocolLib 是唯一的封包拦截通道（真异步扣包），由服务端提供，scope=provided。
          编译期取 dmulloy2 公开仓库中可稳定解析的 release 版本；
          运行期实测为 5.5.0-SNAPSHOT，因此源码引用的 API 必须在 5.3.0 与 5.5.0 上都成立，
          由 CI 编译作为该硬约束的守门人。不要改用 SNAPSHOT（解析会抖动）。
        -->
        <protocolLib.version>5.3.0</protocolLib.version>

        <!--
          Netty 缓冲区：Paper 服务端本身内置（ProtocolLib 也依赖它），故 scope=provided。
          区块编解码直接复用 Netty ByteBuf，避免自造字节游标带来的越界风险。
        -->
        <netty.version>4.1.115.Final</netty.version>

        <!--
          zstd-jni：服务端自带（Leaf/Paper 26.x 内置 zstd-jni，leaf.jar 的 META-INF/libraries 也捆绑同款），
          插件类加载器在运行期可见，因此 scope=provided：编译可见、绝不打进插件 jar（插件 jar 体积不因它变化）。
          版本取与本机 Maven 仓库一致、且 API 与运行期 1.5.7-15 兼容的 1.5.7-6，避免 CI 额外联网拉取。
        -->
        <zstd.version>1.5.7-6</zstd.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
        <repository>
            <id>codemc-snapshots</id>
            <url>https://repo.codemc.io/repository/maven-snapshots/</url>
        </repository>
        <repository>
            <id>dmulloy2</id>
            <url>https://repo.dmulloy2.net/repository/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>${packetevents.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.comphenix.protocol</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>${protocolLib.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 版本见上方 properties 的 netty.version 注释 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
            <version>${netty.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          区块磁盘缓存的压缩改用 zstd（服务端自带，见上方 zstd.version 注释）。
          运行期若该库不可用，BufferedLinearV3Format 会自动回退 JDK Deflater（fail-open）。
        -->
        <dependency>
            <groupId>com.github.luben</groupId>
            <artifactId>zstd-jni</artifactId>
            <version>${zstd.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>MikuXrayNet-${project.version}</finalName>

        <resources>
            <!--
              两份插件描述都需要把 ${project.version} 替换成真实版本号。
              注意：这里的 includes 是「白名单」，不在名单内的资源走下面的不过滤分支，
              因此新增描述文件时必须同步加进来，否则 jar 里会残留未替换的占位符。
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                    <include>paper-plugin.yml</include>
                </includes>
            </resource>
            <!-- 其余资源（含两份带中文注释的配置文件）必须原样打包，不做占位符替换 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                    <exclude>paper-plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <!-- release 目标版本由 properties 的 maven.compiler.release 统一提供，不再重复声明 -->
                <configuration>
                    <!--
                      体积优化（依据见文件末尾 <properties> 下方的说明）：只保留行号与源文件名，
                      去掉局部变量表（LocalVariableTable）。
                      写法依据（本机 javap 核实 maven-compiler-plugin 3.13.0 的 AbstractCompilerMojo）：
                        · 参数有三个相关项：debug(boolean, 默认 true)、debuglevel(String)、compilerArgs(List)。
                        · debug 默认 true 时会自动注入 `-g`（= lines,vars,source 全量），故这里显式 debug=false
                          关掉自动注入，再用 compilerArgs 指定 `-g:lines,source`：
                          最终 javac 参数只有一个 `-g:lines,source`，不会出现 `-g` 与 `-g:lines,source` 并存。
                        · 备选写法 debug=true + <debuglevel>lines,source</debuglevel> 同样可用
                          （debuglevel 在 debug=true 时经 plexus-compiler-javac 2.15.0 生成 `-g:<debuglevel>`），
                          此处取 compilerArgs 是因为它不依赖 debug 开关语义，更直观。
                      实测：-g → -g:lines,source 后 .class 未压缩总量 671767 → 572511 字节（-14.78%），
                      jar 压缩后 354985 → 318943 字节（-10.15%）；堆栈仍显示 (RegionFile.java:484)。
                    -->
                    <debug>false</debug>
                    <compilerArgs>
                        <arg>-g:lines,source</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <!--
                      体积优化：不再写入 META-INF/maven/**/pom.xml 与 pom.properties（对运行期无用）。
                      键名依据（本机核实）：
                        · 反编译 maven-jar-plugin 3.4.2 的 META-INF/maven/plugin.xml，参数清单里
                          **没有**顶层 addMavenDescriptor；唯一相关参数是 archive
                          （类型 org.apache.maven.archiver.MavenArchiveConfiguration）。
                        · MavenArchiveConfiguration 的公开方法正是 setAddMavenDescriptor(boolean) /
                          isAddMavenDescriptor()（默认 true），故必须写成 <archive><addMavenDescriptor>。
                      实测：这两个文件压缩后约占 3111 字节（本仓库 pom.xml 实测）。
                    -->
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
        </plugins>
    </build>
</project>